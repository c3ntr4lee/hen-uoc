rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Mỗi người chỉ đọc/ghi hồ sơ của chính mình (ghi nhớ đang mở kế hoạch nào)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /plans/{planId} {
      // Tạo kế hoạch mới: người tạo là chủ và là thành viên duy nhất
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      // Chỉ thành viên đọc được (không ai liệt kê được toàn bộ kế hoạch)
      allow get: if signedIn() && request.auth.uid in resource.data.members;

      allow update: if signedIn() && (
        // Thành viên sửa nội dung; không đổi được chủ kế hoạch
        (request.auth.uid in resource.data.members
          && request.resource.data.owner == resource.data.owner)
        // Người có link mời (biết mã kế hoạch) chỉ được tự thêm mình vào danh sách thành viên
        || (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid]))
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.owner;

      match /files/{file} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.members;
      }
    }
  }
}
